# Application Environment
ENVIRONMENT=development
DEBUG=true
SECRET_KEY=dev-secret-key-enterprise-ai-platform-2026

# Model Provider API Keys
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# PostgreSQL Database Credentials
POSTGRES_SERVER=postgres
POSTGRES_PORT=5432
POSTGRES_USER=ai_user
POSTGRES_PASSWORD=ai_password
POSTGRES_DB=ai_platform_db
DATABASE_URL=sqlite:///./platform.db

# Redis Cache Credentials
REDIS_HOST=redis
REDIS_PORT=6379

# Authentication & Multi-Tenant Security
DEPLOYMENT_MODE=saas
AUTH_MODE=local
ALLOW_PUBLIC_SIGNUP=true
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=14
COOKIE_SECURE=false
# Optional Enterprise OIDC / SSO
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=

# Social OAuth2 Providers (Google, GitHub, Microsoft)
BACKEND_URL=http://localhost:8000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common

# Object Storage (MinIO locally, AWS S3 / R2 in production)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
STORAGE_BACKEND=s3
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET_NAME=ai-platform-uploads
S3_REGION=us-east-1
S3_USE_SSL=false

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
FRONTEND_URL=http://localhost:3000

# SMTP Email (Mailpit locally, Resend/SES/SMTP in production)
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@enterprise-ai.local
SMTP_USE_TLS=false
